{
  "name": "regmyass",
  "version": "1.3.1",
  "description": "RegMyAss - Chrome Extension for automated account registration",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/build.ts",
    "build": "tsc --noEmit && tsx scripts/build.ts",
    "serve:test": "python3 -m http.server 8080 --directory test-pages",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "automation",
    "temp-mail"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
